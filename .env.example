# Environnement local SABOU (développement uniquement, jamais de valeur de production).
# « pnpm env:up » crée .env à partir de ce fichier au premier lancement : chaque variable
# laissée vide ici reçoit un mot de passe tiré au hasard. .env n'est jamais versionné.

# Ports ouverts sur 127.0.0.1 (à changer si un port est déjà pris sur le poste)
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
VALKEY_PORT=6379
S3_PORT=8333
API_PORT=4000

# PostgreSQL : super-utilisateur « postgres », puis un rôle par usage
POSTGRES_PASSWORD=
SABOU_MIGRATOR_PASSWORD=
SABOU_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Console d'administration de Keycloak (utilisateur « admin »)
KEYCLOAK_ADMIN_PASSWORD=

VALKEY_PASSWORD=

# Passerelle S3 de SeaweedFS
S3_ACCESS_KEY=
S3_SECRET_KEY=
