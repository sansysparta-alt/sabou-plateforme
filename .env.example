# Environnement local SABOU (développement uniquement, jamais de valeur de production).
# « pnpm env:up » crée .env à partir de ce fichier au premier lancement : chaque variable
# laissée vide ici reçoit un mot de passe tiré au hasard. .env n'est jamais versionné.

# Ports ouverts sur 127.0.0.1 (à changer si un port est déjà pris sur le poste)
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
VALKEY_PORT=6379
S3_PORT=8333
API_PORT=4000
POWERSYNC_PORT=8090
# Application de gestion (serveur Vite) : adresse de retour enregistrée dans Keycloak
ADMIN_PORT=5173
# Site public (Next.js) : adresse de retour enregistrée dans le domaine « sabou-public » (lot D)
SITE_PORT=3000

# PostgreSQL : super-utilisateur « postgres », puis un rôle par usage
POSTGRES_PASSWORD=
SABOU_MIGRATOR_PASSWORD=
SABOU_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
SABOU_SYNC_PASSWORD=
POWERSYNC_STORAGE_PASSWORD=

# Console d'administration de Keycloak (utilisateur « admin »)
KEYCLOAK_ADMIN_PASSWORD=

# Secret du client « sabou-admin » (US-010), partagé par Keycloak et l'API
SABOU_ADMIN_CLIENT_SECRET=
# Secret du compte de service « sabou-audit » (US-030) : lecture des événements de connexion
SABOU_AUDIT_CLIENT_SECRET=
# Secret du compte de service « sabou-comptes » (lot A) : création, suspension et réactivation des comptes
SABOU_COMPTES_CLIENT_SECRET=
# Secret du client « sabou-site » (lot D) : connexion des citoyens au site public
SABOU_SITE_CLIENT_SECRET=
# Secret du compte de service « sabou-inscription » (lot D) : création des comptes citoyens
SABOU_INSCRIPTION_CLIENT_SECRET=
# Secret du compte de service « sabou-audit » du domaine sabou-public (lot D) : échecs de connexion des citoyens
SABOU_PUBLIC_AUDIT_CLIENT_SECRET=

VALKEY_PASSWORD=

# Jeton racine du coffre OpenBao du poste (US-045) : sert seulement à le préparer
# (infra/local/openbao/init.sh) ; l'API reçoit un jeton limité, jamais celui-ci
OPENBAO_ROOT_TOKEN=

# Passerelle S3 de SeaweedFS
S3_ACCESS_KEY=
S3_SECRET_KEY=

# PowerSync : clé HS256 des jetons de développement (production : clés publiques de Keycloak)
POWERSYNC_JWT_SECRET=
