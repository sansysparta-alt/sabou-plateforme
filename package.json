{
  "name": "sabou-plateforme",
  "private": true,
  "description": "SABOU — plateforme nationale de la médecine traditionnelle guinéenne",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "build": "turbo run build",
    "env:up": "node infra/local/up.mjs up",
    "env:down": "node infra/local/up.mjs down",
    "env:reset": "node infra/local/up.mjs reset",
    "db:migrate": "pnpm --filter @sabou/db migrate",
    "db:hash": "pnpm --filter @sabou/db hash",
    "db:seed": "pnpm --filter @sabou/db seed",
    "ci:local": "node infra/ci/require-git-bash.mjs && bash infra/ci/all.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
