{
  "name": "sabou-plateforme",
  "private": true,
  "description": "SABOU — plateforme nationale de la médecine traditionnelle guinéenne",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "lint": "turbo run lint",
    "format": "prettier --write .",
