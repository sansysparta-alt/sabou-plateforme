{
  "realm": "sabou",
  "displayName": "SABOU",
  "enabled": true,
  "loginTheme": "sabou",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "offlineSessionIdleTimeout": 604800,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 604800,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@sabou.local",
    "fromDisplayName": "SABOU"
  },
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "email"],
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL",
    "UPDATE_PASSWORD",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT",
    "REFRESH_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "administrateur",
        "description": "Rôle technique porté par les 4 profils d'administration : double facteur obligatoire (R-ACC-03)"
      },
      {
        "name": "dg",
        "description": "Direction Générale",
        "composite": true,
        "composites": {
          "realm": ["administrateur"]
        }
      },
      {
        "name": "admin_regional",
        "description": "Administrateur régional",
        "composite": true,
        "composites": {
          "realm": ["administrateur"]
        }
      },
      {
        "name": "admin_prefectoral",
        "description": "Administrateur préfectoral",
        "composite": true,
        "composites": {
          "realm": ["administrateur"]
        }
      },
      {
        "name": "comite",
        "description": "Comité scientifique",
        "composite": true,
        "composites": {
          "realm": ["administrateur"]
        }
      },
      {
        "name": "praticien",
        "description": "Tradipraticien"
      },
      {
        "name": "citoyen",
        "description": "Citoyen"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sabou-admin",
      "name": "Application de gestion SABOU",
      "description": "Client confidentiel : l'API (intermédiaire « BFF ») échange le code et garde les jetons ; le navigateur n'a qu'un cookie de session.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SABOU_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": ["${SABOU_ADMIN_APP_URL}/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SABOU_ADMIN_APP_URL}/",
        "use.refresh.tokens": "true",
        "client.use.lightweight.access.token.enabled": "false"
      },
      "defaultClientScopes": ["basic", "profile", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles (jeton d'identité)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sabou-terrain",
      "name": "Application mobile SABOU (agent préfectoral)",
      "description": "Client public de l'application mobile pour l'agent préfectoral (US-082) : code + PKCE, second facteur, jeton hors ligne de 7 jours au plus.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": ["gn.sabou.mobile:/oauth2redirect"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "gn.sabou.mobile:/oauth2redirect",
        "use.refresh.tokens": "true",
        "client.use.lightweight.access.token.enabled": "false",
        "client.offline.session.idle.timeout": "604800",
        "client.offline.session.max.lifespan": "604800"
      },
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience de l'API",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sabou-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles (jeton d'accès)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sabou-audit",
      "name": "Journal d'audit SABOU",
      "description": "Compte de service de l'API (US-030) : lit les événements de connexion pour les verser au journal d'audit. Rôle view-events seulement ; aucune connexion d'utilisateur.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SABOU_AUDIT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "client.use.lightweight.access.token.enabled": "false"
      },
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": []
    },
    {
      "clientId": "sabou-comptes",
      "name": "Gestion des comptes SABOU",
      "description": "Compte de service de l'API (lot A : US-012, US-013) : crée les comptes invités, les suspend, les réactive et ferme leurs sessions. Rôles manage-users et view-users seulement ; aucune connexion d'utilisateur.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SABOU_COMPTES_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "client.use.lightweight.access.token.enabled": "false"
      },
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-sabou-audit",
      "enabled": true,
      "serviceAccountClientId": "sabou-audit",
      "clientRoles": {
        "realm-management": ["view-events"]
      }
    },
    {
      "username": "service-account-sabou-comptes",
      "enabled": true,
      "serviceAccountClientId": "sabou-comptes",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ],
  "browserFlow": "sabou-browser",
  "resetCredentialsFlow": "sabou-reset-credentials",
  "authenticationFlows": [
    {
      "alias": "sabou-reset-2fa",
      "description": "Mot de passe oublié : code de l'application d'authentification ou code de secours, si le compte en est équipé",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 5,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-reset-credentials",
      "description": "Mot de passe oublié par e-mail (MOE, 17/11/2026). Code du double facteur demandé avant le nouveau mot de passe.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "reset-credentials-choose-user",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "reset-credential-email",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-reset-2fa",
          "requirement": "CONDITIONAL",
          "priority": 25,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "authenticator": "reset-password",
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-browser",
      "description": "Connexion SABOU : mot de passe, puis double facteur obligatoire pour les administrateurs (R-ACC-03), proposé aux autres",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-browser-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-browser-forms",
      "description": "Formulaires de connexion (§2.28) : niveau 1 = mot de passe, sauté quand il vient d'être saisi et que l'API demande le niveau 2 (acr_values=2) ; puis second facteur, toujours.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "sabou-level-1",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-level-2",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-level-1",
      "description": "Niveau 1 : mot de passe (valable 10 minutes pour une demande de niveau 2 qui suit)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "sabou-loa-1",
          "requirement": "REQUIRED",
          "priority": 5,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "sabou-amr-pwd",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-level-2",
      "description": "Niveau 2 : second facteur, toujours exécuté, quel que soit le niveau demandé. « Allow access » le clôt quand aucun second facteur ne s'applique (§2.28).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "sabou-2fa-admin",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-optional",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "authenticator": "allow-access-authenticator",
          "requirement": "REQUIRED",
          "priority": 40,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin",
      "description": "Administrateurs : code à usage unique obligatoire, configuré à la première connexion",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "sabou-is-admin",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin-methods",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin-setup",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin-setup",
      "description": "Administrateur sans second facteur : activation imposée avant d'accéder à l'application (code à usage unique, puis codes de secours)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-credential",
          "authenticatorConfig": "sabou-no-second-factor-used",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "sabou-amr-otp-setup",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin-methods",
      "description": "Administrateur équipé : code de l'application d'authentification, ou code de secours. Chaque méthode est dans son propre sous-parcours, où elle est REQUIRED : Keycloak n'inscrit pas une étape ALTERNATIVE dans le claim « amr ».",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 5,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin-totp",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin-recovery",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin-totp",
      "description": "Code de l'application d'authentification",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "sabou-amr-otp",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin-recovery",
      "description": "Code de secours (téléphone perdu)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-recovery-authn-code-form",
          "authenticatorConfig": "sabou-amr-otp-recovery",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-optional",
      "description": "Praticiens et citoyens : code demandé seulement s'ils l'ont activé",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "sabou-is-not-admin",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "sabou-amr-otp-optional",
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "sabou-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "600"
      }
    },
    {
      "alias": "sabou-amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "604800"
      }
    },
    {
      "alias": "sabou-amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "604800"
      }
    },
    {
      "alias": "sabou-amr-otp-recovery",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "604800"
      }
    },
    {
      "alias": "sabou-amr-otp-optional",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "604800"
      }
    },
    {
      "alias": "sabou-amr-otp-setup",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "604800"
      }
    },
    {
      "alias": "sabou-no-second-factor-used",
      "config": {
        "credentials": "otp##recovery-authn-codes",
        "included": "false"
      }
    },
    {
      "alias": "sabou-is-admin",
      "config": {
        "condUserRole": "administrateur",
        "negate": "false"
      }
    },
    {
      "alias": "sabou-is-not-admin",
      "config": {
        "condUserRole": "administrateur",
        "negate": "true"
      }
    }
  ]
}
