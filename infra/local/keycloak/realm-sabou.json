{
  "realm": "sabou",
  "displayName": "SABOU",
  "enabled": true,
  "loginTheme": "sabou",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL",
    "UPDATE_PASSWORD",
    "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "USER_DISABLED_BY_PERMANENT_LOCKOUT",
    "REFRESH_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "administrateur",
        "description": "Rôle technique porté par les 4 profils d'administration : double facteur obligatoire (R-ACC-03)"
      },
      {
        "name": "dg",
        "description": "Direction Générale",
        "composite": true,
        "composites": {
          "realm": ["administrateur"]
        }
      },
      {
        "name": "admin_regional",
        "description": "Administrateur régional",
        "composite": true,
        "composites": {
          "realm": ["administrateur"]
        }
      },
      {
        "name": "admin_prefectoral",
        "description": "Administrateur préfectoral",
        "composite": true,
        "composites": {
          "realm": ["administrateur"]
        }
      },
      {
        "name": "comite",
        "description": "Comité scientifique",
        "composite": true,
        "composites": {
          "realm": ["administrateur"]
        }
      },
      {
        "name": "praticien",
        "description": "Tradipraticien"
      },
      {
        "name": "citoyen",
        "description": "Citoyen"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sabou-admin",
      "name": "Application de gestion SABOU",
      "description": "Client confidentiel : l'API (intermédiaire « BFF ») échange le code et garde les jetons ; le navigateur n'a qu'un cookie de session.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SABOU_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": ["${SABOU_ADMIN_APP_URL}/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SABOU_ADMIN_APP_URL}/",
        "use.refresh.tokens": "true",
        "client.use.lightweight.access.token.enabled": "false"
      },
      "defaultClientScopes": ["basic", "profile", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles (jeton d'identité)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "browserFlow": "sabou-browser",
  "authenticationFlows": [
    {
      "alias": "sabou-browser",
      "description": "Connexion SABOU : mot de passe, puis double facteur obligatoire pour les administrateurs (R-ACC-03), proposé aux autres",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-browser-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-browser-forms",
      "description": "Formulaires de connexion",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "sabou-amr-pwd",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-optional",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin",
      "description": "Administrateurs : code à usage unique obligatoire, configuré à la première connexion",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "sabou-is-admin",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin-methods",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin-setup",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin-setup",
      "description": "Administrateur sans second facteur : activation imposée avant d'accéder à l'application (code à usage unique, puis codes de secours)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-credential",
          "authenticatorConfig": "sabou-no-second-factor-used",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "sabou-amr-otp-setup",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin-methods",
      "description": "Administrateur équipé : code de l'application d'authentification, ou code de secours. Chaque méthode est dans son propre sous-parcours, où elle est REQUIRED : Keycloak n'inscrit pas une étape ALTERNATIVE dans le claim « amr ».",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 5,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin-totp",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "sabou-2fa-admin-recovery",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin-totp",
      "description": "Code de l'application d'authentification",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "sabou-amr-otp",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-admin-recovery",
      "description": "Code de secours (téléphone perdu)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-recovery-authn-code-form",
          "authenticatorConfig": "sabou-amr-otp-recovery",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sabou-2fa-optional",
      "description": "Praticiens et citoyens : code demandé seulement s'ils l'ont activé",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "sabou-is-not-admin",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "sabou-amr-otp-optional",
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "sabou-amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "sabou-amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "sabou-amr-otp-recovery",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "sabou-amr-otp-optional",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "sabou-amr-otp-setup",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "sabou-no-second-factor-used",
      "config": {
        "credentials": "otp##recovery-authn-codes",
        "included": "false"
      }
    },
    {
      "alias": "sabou-is-admin",
      "config": {
        "condUserRole": "administrateur",
        "negate": "false"
      }
    },
    {
      "alias": "sabou-is-not-admin",
      "config": {
        "condUserRole": "administrateur",
        "negate": "true"
      }
    }
  ]
}
