{
  "name": "@sabou/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Application de gestion SABOU (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "serve": "node scripts/serve.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@sabou/ui": "workspace:*",
    "preact": "10.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.64.1",
    "@sabou/qr": "workspace:*",
    "@sabou/types": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "3.2.6",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
